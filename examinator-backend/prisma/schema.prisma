generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  middleName    String?
  email         String?  @unique
  matricNumber  String?  @unique
  password      String?
  role          Role
  provider      Provider @default(LOCAL)
  providerId    String?
  about         String?
  school        String 
  isFirstLogin  Boolean  @default(true)
  createdAt     DateTime @default(now())
}

enum Role {
  STUDENT
  EXAMINER
}

enum Provider {
  LOCAL
  GOOGLE
}