generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  middleName    String?
  email         String?  @unique
  matricNumber  String?  @unique
  password      String?
  role          Role
  provider      Provider @default(LOCAL)
  providerId    String?
  about         String?
  school        String
  emailVerified          Boolean   @default(false)
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  country       String?
  department    String?
  faculty       String?
  lecturerId    String?
  meta          Json?   
  isFirstLogin  Boolean  @default(true)
  createdAt     DateTime @default(now())
  courses       Course[]
}

/// Lecturer-owned offering. Use `academicYear`, `semester`, `studentLevel` for filters;
/// put school-specific wording in `meta` (e.g. display labels, local term names).
model Course {
  id             String   @id @default(uuid())
  /** Short identifier (e.g. CSC101). Unique per lecturer — see @@unique below. */
  courseCode     String
  title          String
  description    String   @default("") @db.Text
  academicYear   String
  semester       String
  studentLevel   String?
  meta           Json?
  examinerId     String
  examiner       User     @relation(fields: [examinerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([examinerId, courseCode])
  @@index([academicYear, semester])
  @@index([studentLevel])
}

enum Role {
  STUDENT
  EXAMINER
}

enum Provider {
  LOCAL
  GOOGLE
}